models/**/*
!models/**/.gitkeep
*.parquet
*.pt
*.pkl
*.joblib
*.zip
*.pcap

# --- Transient run logs ---
reports/**/*_stdout.txt

# --- Secrets ---
.env
.env.*
keys/
*.key
*.pem
secrets/

