.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# --- Frontend ---
frontend/node_modules/
frontend/dist/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json

# --- Databases ---
*.sqlite
*.sqlite3
*.db
